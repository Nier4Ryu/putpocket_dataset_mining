{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://putpocket.invalid/schemas/glm52-dsa-capture-v1.json",
  "title": "Bounded native GLM-5.2 DSA score capture",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "run_id",
    "instance_id",
    "trace_mode",
    "phase",
    "layer",
    "full_indexer_layer",
    "shared_layers",
    "query_position",
    "decode_step",
    "context_length",
    "rank",
    "backend_identities",
    "dtype",
    "device",
    "native_logits_shape",
    "topk",
    "source_token_coordinate_semantics",
    "native_transform_kind",
    "native_selected_logical_token_ids",
    "native_selected_scores",
    "native_pre_topk_raw_score_vector",
    "native_forced_token_mask",
    "revisions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "native_glm52_dsa_indexer_scores"},
    "trace_mode": {"const": "ON"},
    "phase": {"enum": ["prefill_last_query", "decode"]},
    "layer": {"type": "integer", "minimum": 0, "maximum": 77},
    "full_indexer_layer": {"type": "integer", "minimum": 0, "maximum": 77},
    "shared_layers": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
    "decode_step": {"type": ["integer", "null"]},
    "context_length": {"type": "integer", "minimum": 2049, "maximum": 4096},
    "rank": {"type": "integer", "minimum": 0, "maximum": 3},
    "topk": {"const": 2048},
    "native_transform_kind": {"enum": ["paged", "ragged"]},
    "native_selected_logical_token_ids": {"type": "array", "minItems": 2048, "maxItems": 2048, "items": {"type": "integer"}, "uniqueItems": true},
    "native_selected_scores": {"type": "array", "minItems": 2048, "maxItems": 2048, "items": {"type": "number"}},
    "native_pre_topk_raw_score_vector": {"type": "array", "minItems": 2049, "maxItems": 4096, "items": {"type": "number"}}
  },
  "additionalProperties": false
}
