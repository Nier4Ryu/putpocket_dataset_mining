{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://putpocket.local/schemas/glm52_rank_normalized_full_distribution_input_attestation.schema.json",
  "title": "GLM rank-normalized full-distribution input attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "analysis_project_commit",
    "source_artifact_label",
    "source_project_commit",
    "source_report_payload_sha256",
    "source_final_checksum_manifest",
    "source_manifest_entries",
    "source_manifest_entry_count",
    "all_source_entries_verified",
    "primary_variant_id",
    "token_count",
    "levels",
    "token_identity_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_kind": {"const": "glm52_rank_normalized_full_distribution_input_attestation"},
    "analysis_project_commit": {"$ref": "#/$defs/commit"},
    "source_artifact_label": {"type": "string", "minLength": 1, "pattern": "^[^/]+$"},
    "source_project_commit": {"$ref": "#/$defs/commit"},
    "source_report_payload_sha256": {"$ref": "#/$defs/sha256"},
    "source_final_checksum_manifest": {"$ref": "#/$defs/file"},
    "source_manifest_entries": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/file"}
    },
    "source_manifest_entry_count": {"type": "integer", "minimum": 4},
    "all_source_entries_verified": {"const": true},
    "primary_variant_id": {"const": "rank_dcg_k64"},
    "token_count": {"type": "integer", "minimum": 1},
    "levels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 16}
    },
    "token_identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
