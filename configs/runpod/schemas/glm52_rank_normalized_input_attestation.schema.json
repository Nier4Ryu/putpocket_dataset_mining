{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://putpocket.local/schemas/glm52_rank_normalized_input_attestation.schema.json",
  "title": "GLM rank-normalized multihop input attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "project_commit",
    "checksum_manifest",
    "episode_inputs",
    "capture_control_inputs",
    "matrix_inputs",
    "matrix_input_count",
    "legacy_signed_inputs",
    "all_inputs_checksum_attested"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_kind": {"const": "glm52_rank_normalized_multihop_input_attestation"},
    "project_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "checksum_manifest": {"$ref": "#/$defs/file"},
    "episode_inputs": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"$ref": "#/$defs/file"}
    },
    "capture_control_inputs": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"$ref": "#/$defs/file"}
    },
    "matrix_inputs": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/file"}
    },
    "matrix_input_count": {"type": "integer", "minimum": 1},
    "legacy_signed_inputs": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"$ref": "#/$defs/file"}
    },
    "all_inputs_checksum_attested": {"const": true}
  },
  "$defs": {
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
