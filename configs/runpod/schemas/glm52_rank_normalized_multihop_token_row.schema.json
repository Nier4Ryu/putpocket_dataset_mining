{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://putpocket.local/schemas/glm52_rank_normalized_multihop_token_row.schema.json",
  "title": "GLM rank-normalized multihop token row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "position",
    "token_id",
    "segment_membership",
    "seed_probability",
    "variants",
    "record_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "position": {"type": "integer", "minimum": 0},
    "token_id": {"type": "integer", "minimum": 0},
    "segment_membership": {
      "type": "array", "maxItems": 2, "uniqueItems": true,
      "items": {"enum": ["q1", "q2"]}
    },
    "seed_probability": {"type": "number", "minimum": 0, "maximum": 1},
    "variants": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["variant_id", "levels"],
        "properties": {
          "variant_id": {"type": "string", "minLength": 1},
          "levels": {
            "type": "array", "minItems": 1, "maxItems": 16,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": [
                "level", "hop_probability", "hop_rank",
                "cumulative_probability", "cumulative_rank"
              ],
              "properties": {
                "level": {"type": "integer", "minimum": 1, "maximum": 16},
                "hop_probability": {"type": "number", "minimum": 0, "maximum": 1},
                "hop_rank": {"type": "integer", "minimum": 1},
                "cumulative_probability": {"type": "number", "minimum": 0, "maximum": 1},
                "cumulative_rank": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    },
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
