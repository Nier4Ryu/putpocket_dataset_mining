{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://putpocket.local/schemas/glm52_rank_normalized_plot_summary.schema.json",
  "title": "GLM rank-normalized multihop plot summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "project_commit", "implementation",
    "inputs", "recurrence_id", "primary_variant_id", "max_level",
    "stable_top_union", "primary_k64_table", "display_policy", "outputs",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_kind": {"const": "glm52_rank_normalized_multihop_plot_summary"},
    "project_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "implementation": {"$ref": "#/$defs/pathDigest"},
    "inputs": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/file"}},
    "recurrence_id": {"const": "putpocket_rank_normalized_indexer_multihop_v1"},
    "primary_variant_id": {"const": "rank_dcg_k64"},
    "max_level": {"type": "integer", "minimum": 1, "maximum": 16},
    "stable_top_union": {
      "type": "object", "additionalProperties": false,
      "required": ["evaluation_k", "positions"],
      "properties": {
        "evaluation_k": {"const": 64},
        "positions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}
      }
    },
    "primary_k64_table": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "object"}},
    "display_policy": {"type": "object", "minProperties": 3},
    "outputs": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/file"}},
    "claim_boundary": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "safePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pathDigest": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/safePath"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
