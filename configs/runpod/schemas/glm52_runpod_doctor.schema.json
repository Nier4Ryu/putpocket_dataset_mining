{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://putpocket.invalid/schemas/glm52_runpod_doctor.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "payload_sha256"],
  "properties": {
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "test_id", "status", "read_only", "project_commit", "vllm_commit", "model_revision", "checks"],
      "properties": {
        "schema_version": {"const": 1},
        "test_id": {"const": "glm52-runpod-doctor-v1"},
        "status": {"enum": ["passed", "failed"]},
        "read_only": {"const": true},
        "project_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "vllm_commit": {"const": "4a3447d200e5aa428d68d1a00aa00f1a19a1a729"},
        "model_revision": {"const": "aec724e8c7b8ee9db3b48c01c320f63f9cdaf8aa"},
        "checks": {
          "type": "array",
          "minItems": 10,
          "items": {
            "type": "object",
            "required": ["check_id", "status"],
            "properties": {
              "check_id": {"type": "string", "minLength": 1},
              "status": {"enum": ["passed", "failed"]},
              "evidence": {},
              "error_type": {"type": "string"},
              "error": {"type": "string"}
            },
            "additionalProperties": false,
            "allOf": [
              {"if": {"properties": {"status": {"const": "passed"}}}, "then": {"required": ["evidence"]}},
              {"if": {"properties": {"status": {"const": "failed"}}}, "then": {"required": ["error_type", "error"]}}
            ]
          }
        }
      }
    }
  }
}
