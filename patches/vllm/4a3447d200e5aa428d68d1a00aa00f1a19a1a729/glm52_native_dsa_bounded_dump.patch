diff --git a/docker/Dockerfile b/docker/Dockerfile
index 96ed0bd..cb5e660 100644
--- a/docker/Dockerfile
+++ b/docker/Dockerfile
@@ -543,2 +542,0 @@ WORKDIR /workspace
-# Copy pre-built csrc wheel directly
-COPY --from=csrc-build /workspace/dist /precompiled-wheels
@@ -559,3 +556,0 @@ ENV VLLM_TARGET_DEVICE=${vllm_target_device}
-# Skip adding +precompiled suffix to version (preserves git-derived version)
-ENV VLLM_SKIP_PRECOMPILED_VERSION_SUFFIX=1
-
@@ -568 +563,8 @@ RUN --mount=type=cache,target=/opt/uv/cache \
-# Build the vLLM wheel
+# Provision the exact DeepGEMM build interpreters used by the official
+# csrc-build stage, then build the complete wheel directly from this source
+# tree.  The diagnostic contract forbids the build-stage shortcut through
+# VLLM_USE_PRECOMPILED, even when that shortcut wheel was built locally.
+ENV DEEPGEMM_VENV_PREFIX=/opt/dgenv
+RUN --mount=type=cache,target=/root/.cache/uv \
+    tools/setup_deepgemm_pythons.sh > /tmp/dg_pythons.txt
+
@@ -571,4 +573,5 @@ RUN --mount=type=cache,target=/opt/uv/cache \
-    if [ "${vllm_target_device}" = "cuda" ]; then \
-        export VLLM_USE_PRECOMPILED=1; \
-        export VLLM_PRECOMPILED_WHEEL_LOCATION=$(ls /precompiled-wheels/*.whl); \
-    fi && \
+    rm -rf .deps && \
+    mkdir -p .deps && \
+    unset VLLM_USE_PRECOMPILED VLLM_PRECOMPILED_WHEEL_LOCATION && \
+    export VLLM_DOCKER_BUILD_CONTEXT=1 && \
+    export DEEPGEMM_PYTHON_INTERPRETERS=$(cat /tmp/dg_pythons.txt) && \
