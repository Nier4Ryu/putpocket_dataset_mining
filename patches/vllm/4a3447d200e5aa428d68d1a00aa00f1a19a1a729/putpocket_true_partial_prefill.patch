+        query_start_cpu = torch.arange(num_rows + 1, dtype=torch.int32)
+        query_start = query_start_cpu.to(device=positions.device, non_blocking=True)
+        seq_lens_cpu = positions_cpu + 1
+        seq_lens = seq_lens_cpu.to(device=positions.device, non_blocking=True)
+        block_table = self.block_table_tensor[:1].repeat(num_rows, 1)
+        return replace(
+            self,
+            query_start_loc=query_start,
+            query_start_loc_cpu=query_start_cpu,
+            seq_lens=seq_lens,
+            _seq_lens_cpu=seq_lens_cpu,
+            _num_computed_tokens_cpu=positions_cpu,
+            seq_lens_cpu_upper_bound=seq_lens_cpu,
+            num_reqs=num_rows,
+            num_actual_tokens=num_rows,
+            max_query_len=1,
+            max_seq_len=int(seq_lens_cpu.max().item()),
+            block_table_tensor=block_table,
+            is_prefilling=torch.zeros(
+                num_rows, dtype=torch.bool, device=positions.device
+            ),
+            dcp_local_seq_lens=None,
+            dcp_local_seq_lens_cpu=None,
+            putpocket_true_partial_positions=None,
+            _num_computed_tokens_cache=None,
+            _token_to_req_indices_cache=None,
+        )
+
