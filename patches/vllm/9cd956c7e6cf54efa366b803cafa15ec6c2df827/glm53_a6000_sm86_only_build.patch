diff --git a/cmake/utils.cmake b/cmake/utils.cmake
index 6ded936..1de84b0 100644
--- a/cmake/utils.cmake
+++ b/cmake/utils.cmake
@@ -512,6 +512,14 @@ function(cuda_archs_loose_intersection OUT_CUDA_ARCHS SRC_CUDA_ARCHS TGT_CUDA_AR
   endforeach()
   set(_CUDA_ARCHS ${_FINAL_ARCHS})
 
+  # The task-owned A6000 image must not carry lower-Ampere PTX or SASS chosen
+  # by loose compatibility matching. A nonempty result here means the source
+  # supports this Ampere family; compile that source specifically for SM86.
+  # Unsupported newer-only sources remain empty and are not built.
+  if("$ENV{PUTPOCKET_SM86_ONLY}" STREQUAL "1" AND _CUDA_ARCHS)
+    set(_CUDA_ARCHS "8.6")
+  endif()
+
   set(${OUT_CUDA_ARCHS} ${_CUDA_ARCHS} PARENT_SCOPE)
 endfunction()
 
