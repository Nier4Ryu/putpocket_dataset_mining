-    include(cmake/external_projects/vllm_flash_attn.cmake)
+    if("$ENV{PUTPOCKET_GLM53_DUAL_ARCH}" STREQUAL "1")
+        message(STATUS "PutPocket GLM-5.3 dual-arch build: SM90a and SM120a")
+        message(STATUS "PutPocket GLM-5.3 dual-arch build: DeepGEMM and FlashKDA enabled")
+        message(STATUS "PutPocket GLM-5.3 dual-arch build: common FA2/FA3 import extensions enabled")
+        message(STATUS "PutPocket GLM-5.3 dual-arch build: FlashMLA, QuTLASS, fmha_sm100, and tml_fa4 omitted")
