+def _pad_tiny_glm_indexer_heads(
+    q: tuple[torch.Tensor, torch.Tensor | None],
+    weights: torch.Tensor,
+) -> tuple[tuple[torch.Tensor, torch.Tensor | None], torch.Tensor]:
+    q_values, q_scale = q
+    if q_values.shape[-2] != 8:
+        return q, weights
+
+    pad_shape = list(q_values.shape)
+    pad_shape[-2] = 8
+    q_values = torch.cat(
+        [q_values, q_values.new_zeros(pad_shape)],
+        dim=-2,
+    )
+
+    if q_scale is not None:
+        scale_pad_shape = list(q_scale.shape)
+        scale_pad_shape[-1] = 8
+        q_scale = torch.cat(
+            [q_scale, q_scale.new_zeros(scale_pad_shape)],
+            dim=-1,
+        )
+
+    weights = torch.cat(
+        [weights, weights.new_zeros((*weights.shape[:-1], 8))],
+        dim=-1,
+    )
+    return (q_values, q_scale), weights
+
+
